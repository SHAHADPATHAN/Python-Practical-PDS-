# ==============================================================================
# PDS Log Intelligence — Git Ignore Rules
# ==============================================================================

# Python Bytecode & Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/*.tar.gz
dist/*.whl
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# Node & Frontend Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS & Editor Metadata
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Temporary Uploads (Keep directory with .gitkeep)
uploads/*
!uploads/.gitkeep

# Large Raw and Generated Datasets (>100MB, exceeds GitHub limit)
# Note: These can be regenerated via practicals 01-05 and practical 10
Data/raw/cj.log
Data/processed/structured_logs.csv
Data/processed/cleaned_logs.csv
Data/processed/labeled_logs.csv
Data/processed/features.csv
Data/processed/pipeline_cleaned.csv
Data/processed/pipeline_cleaned_labeled.csv
Data/processed/pipeline_features.csv

# Keep Small Processed Data Needed for Dashboard & ML
!Data/processed/balanced_logs.csv
!Data/processed/ip_summary.csv
!Data/processed/hourly_activity.csv
!Data/processed/label_hour_pivot.csv
!Data/processed/filtered_activity.csv
